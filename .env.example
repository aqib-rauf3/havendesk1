# =====================================================================
# HavenDesk AI Receptionist — Environment Configuration (.env)
# =====================================================================
# TEST MODE works 100% out of the box with zero external keys required.
# All simulated calls, SMS/WhatsApp messages, triage, and bookings operate
# immediately on http://localhost:3000.
#
# When you are ready for LIVE PRODUCTION, simply fill in the keys below.
# No code modifications are needed.
# =====================================================================

# -------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# -------------------------------------------------------------
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# 32-character secret used to sign session cookies & tokens
SESSION_SECRET=havendesk_super_secret_session_key_2026_change_in_prod

# 32-byte hex key for AES-256-GCM encryption of client API keys at rest in SQLite
# Generate a new random key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database path (defaults to built-in SQLite; can point to PostgreSQL in production)
DATABASE_PATH=./server/db/havendesk.sqlite
# DATABASE_URL=postgresql://user:password@localhost:5432/havendesk

# -------------------------------------------------------------
# 2. STRIPE BILLING & SUBSCRIPTION (Required for Live Payments)
# -------------------------------------------------------------
# Get these from your Stripe Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_placeholder_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_here
# Webhook signing secret from https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret

# -------------------------------------------------------------
# 3. TELEPHONY & VOICE AI (Choose Twilio, Vapi, or Retell AI)
# -------------------------------------------------------------
# Option A: Twilio Voice & SMS (https://console.twilio.com)
TWILIO_ACCOUNT_SID=AC_placeholder_twilio_account_sid
TWILIO_AUTH_TOKEN=placeholder_twilio_auth_token
TWILIO_PHONE_NUMBER=+18005550199
TWILIO_WHATSAPP_NUMBER=+14155238886

# Option B: Vapi Voice AI (https://vapi.ai)
VAPI_API_KEY=vapi_sec_placeholder
VAPI_ASSISTANT_ID=vapi_asst_placeholder

# Option C: Retell AI (https://retellai.com)
RETELL_API_KEY=retell_key_placeholder

# -------------------------------------------------------------
# 4. WHATSAPP & MESSAGING (Twilio or Meta Cloud API)
# -------------------------------------------------------------
# Meta WhatsApp Cloud API (https://developers.facebook.com)
META_WHATSAPP_TOKEN=EAAG_placeholder_meta_token
META_PHONE_NUMBER_ID=109876543210987

# -------------------------------------------------------------
# 5. CALENDAR & SCHEDULING INTEGRATIONS
# -------------------------------------------------------------
# Cal.com API Key (https://cal.com)
CALCOM_API_KEY=cal_live_placeholder
# Google Calendar Service Account or Calendar ID
GOOGLE_CALENDAR_ID=primary

# -------------------------------------------------------------
# 6. AI & LLM PROVIDERS (Optional: OpenAI, Anthropic, or Groq)
# -------------------------------------------------------------
# When omitted, HavenDesk uses its built-in rule-based triage & tool engine.
OPENAI_API_KEY=sk-placeholder-openai-key
GROQ_API_KEY=gsk_placeholder_groq_key


# -------------------------------------------------------------
# 7. GOOGLE GEMINI MULTILINGUAL RECEPTIONIST ENGINE
# -------------------------------------------------------------
# Supports Urdu (اردو), Roman Urdu, English, Punjabi, & Code-Switching
# Get your API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
